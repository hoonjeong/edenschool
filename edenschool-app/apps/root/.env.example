# ── 데이터베이스 ──
DB_HOST=
DB_PORT=3306
DB_NAME=edenschool
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# ── 독서교육원(edenbooks) 전용 DB ──
# 독서교육원(code=R) 관리자용 /reading 앱이 사용하는 별도 데이터베이스.
# 같은 서버라면 아래 접속정보는 비워도 되고(위 DB_* 자격증명 재사용), DB 이름만 지정하면 된다.
# 테이블은 sql/edenbooks-init.sql 로 최초 1회 생성.
EDENBOOKS_DB_NAME=edenbooks
# EDENBOOKS_DB_HOST=          # 미설정 시 DB_HOST 재사용
# EDENBOOKS_DB_PORT=3306      # 미설정 시 DB_PORT 재사용
# EDENBOOKS_DB_USER=          # 미설정 시 DB_USER 재사용
# EDENBOOKS_DB_PASSWORD=      # 미설정 시 DB_PASSWORD 재사용
# EDENBOOKS_DB_CONNECTION_LIMIT=5
# Prisma CLI(generate/migrate) 전용. 런타임엔 불필요.
# EDENBOOKS_DATABASE_URL=mysql://user:pass@localhost:3306/edenbooks

# ── 파일 업로드 ──
UPLOAD_DIR=./uploads
# 업로드 파일 디스크 폴더(레거시와 동일 구조). 미설정 시 edenschool-app/upload 사용.
#   <폴더>/        → 첨부파일,  <폴더>/image/ → 본문 이미지
# 구 시스템 upload 폴더를 이 경로에 그대로 복사하면 옛 글 첨부/이미지가 서빙된다.
# LEGACY_UPLOAD_DIR=/home/ubuntu/edenschool/edenschool-app/upload

# ── 세션 ──
SESSION_SECRET=
SESSION_COOKIE_NAME=edenschool-session
SESSION_TTL=10800
COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_NAME=edenschool-admin-session
ADMIN_SESSION_TTL=10800

# ── 비밀번호 해싱 ──
# bcrypt 전환 플래그(롤아웃/롤백 스위치). user_info.pw, admin_user_info.pw 모두 VARCHAR(100)이라
# bcrypt 해시(60자)가 그대로 저장됨 → DB 변경 불필요.
# true: bcrypt 저장 + 로그인 시 SHA1→bcrypt 재해싱 / false(기본): 기존 SHA1 유지. 재배포 없이 토글 가능.
PASSWORD_BCRYPT_ENABLED=false

# ── SMS (알리고) ──
SMS_USER_ID=
SMS_AUTH_KEY=
SMS_DEFAULT_CALLNUM=
SMS_API_URL=https://apis.aligo.in/send/
SMS_PREFIX=[이든배움국어학원]

# ── 알림 ──
NOTIFY_PHONE=

# ── 사이트 정보 ──
# SITE_URL: 검색엔진 최적화(sitemap.xml, robots.txt, OG 태그, canonical)의 절대 URL 기준.
#   - 설정 시: 그 값으로 고정(운영 도메인 확정 후 지정 권장). 프로토콜 포함, 끝 슬래시 없이.
#   - 미설정 시: 접속한 요청의 host로 자동 구성 → IP로 운영하는 개발 기간엔 지정하지 않아도 됨.
# 개발(IP) 예: 비워둠 / 운영 예: SITE_URL=https://edenschool.kr
# SITE_URL=
SITE_TITLE=부천국어학원 이든배움국어학원
SITE_DESCRIPTION=부천국어학원 이든배움국어학원입니다.
SITE_KEYWORDS=부천국어학원,이든배움국어학원

# ── AI (Claude API) ──
ANTHROPIC_API_KEY=

# ── 수업자료생성 (/admin/lesson-material) ──
# 테이블은 sql/lesson-material.sql 로 최초 1회 생성(운영 DB에 사용자가 직접 적용).
# 접속 정보는 위 DB_* 를 그대로 재사용하되, 4바이트 문자(이모지) 보존을 위해 별도 utf8mb4 풀을 쓴다.
# LESSON_MATERIAL_MODEL=claude-opus-5
# LESSON_MATERIAL_MAX_TOKENS=32000   # 사고 토큰 + 본문 합산 상한이라 넉넉히
# LESSON_MATERIAL_EFFORT=high        # low | medium | high | xhigh | max (높을수록 품질↑ 비용·시간↑)
# LESSON_MATERIAL_MAX_UPLOAD_MB=25
# LESSON_MATERIAL_UPLOAD_DIR=        # 미설정 시 업로드 루트/lesson-material 사용
# LESSON_MATERIAL_DB_CONNECTION_LIMIT=5

# ── 데이터 임포트 스크립트 (선택) ──
# IMPORT_PREV_TESTS_DIR=./data/이든 학교별 한글파일
# IMPORT_SPLIT_FILES_DIR=./data/쪼개기 파일
# IMPORT_OTHER_TESTS_DIR=./data/타지역 시험지 한글파일
