# ── 데이터베이스 ──
DB_HOST=
DB_PORT=3306
DB_NAME=edenschool
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# ── 파일 업로드 ──
UPLOAD_DIR=./uploads
# 업로드 파일 디스크 폴더(레거시와 동일 구조). 미설정 시 edenschool-app/upload 사용.
#   <폴더>/        → 첨부파일,  <폴더>/image/ → 본문 이미지
# 구 시스템 upload 폴더를 이 경로에 그대로 복사하면 옛 글 첨부/이미지가 서빙된다.
# LEGACY_UPLOAD_DIR=/home/ubuntu/edenschool/edenschool-app/upload

# ── 세션 ──
SESSION_SECRET=
SESSION_COOKIE_NAME=edenschool-session
SESSION_TTL=10800
COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_NAME=edenschool-admin-session
ADMIN_SESSION_TTL=10800

# ── 비밀번호 해싱 ──
# bcrypt 전환 플래그(롤아웃/롤백 스위치). user_info.pw, admin_user_info.pw 모두 VARCHAR(100)이라
# bcrypt 해시(60자)가 그대로 저장됨 → DB 변경 불필요.
# true: bcrypt 저장 + 로그인 시 SHA1→bcrypt 재해싱 / false(기본): 기존 SHA1 유지. 재배포 없이 토글 가능.
PASSWORD_BCRYPT_ENABLED=false

# ── SMS (알리고) ──
SMS_USER_ID=
SMS_AUTH_KEY=
SMS_DEFAULT_CALLNUM=
SMS_API_URL=https://apis.aligo.in/send/
SMS_PREFIX=[이든배움국어학원]

# ── 알림 ──
NOTIFY_PHONE=

# ── 사이트 정보 ──
# SITE_URL: 검색엔진 최적화(sitemap.xml, robots.txt, OG 태그, canonical)에 쓰이는 운영 도메인.
# 미설정 시 https://edenschool.kr 사용. 프로토콜 포함, 끝 슬래시 없이.
SITE_URL=https://edenschool.kr
SITE_TITLE=부천국어학원 이든배움국어학원
SITE_DESCRIPTION=부천국어학원 이든배움국어학원입니다.
SITE_KEYWORDS=부천국어학원,이든배움국어학원

# ── AI (Claude API) ──
ANTHROPIC_API_KEY=

# ── 데이터 임포트 스크립트 (선택) ──
# IMPORT_PREV_TESTS_DIR=./data/이든 학교별 한글파일
# IMPORT_SPLIT_FILES_DIR=./data/쪼개기 파일
# IMPORT_OTHER_TESTS_DIR=./data/타지역 시험지 한글파일
