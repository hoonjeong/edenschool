// 이든 독서교육원(edenbooks) 관리 툴 — 데이터 모델
// edenschool 운영 DB와 분리된 별도 데이터베이스(edenbooks)에서 사용.
// 런타임 연결은 src/lib/reading/prisma.ts 의 드라이버 어댑터가 담당하고,
// 이 스키마는 클라이언트 생성(prisma generate)과 DDL 참조용이다.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/reading/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── 사용자(선생님/원장) ────────────────────────────────
enum UserRole {
  ADMIN // 원장(관리자)
  TEACHER // 담당 선생님
  CLINIC // 클리닉 선생님
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  role         UserRole @default(TEACHER)
  active       Boolean  @default(true)
  passwordHash String? // scrypt 해시 (로그인용)
  createdAt    DateTime @default(now())

  classes Class[] // 담당 반
}

// ── 문자 발송 로그 (알리고) ─────────────────────────────
model SmsLog {
  id            Int      @id @default(autoincrement())
  sendId        Int      @default(0)
  phone         String
  message       String   @db.Text
  type          String   @default("SMS") // SMS/LMS/MMS
  title         String?
  resultMessage String?  @db.Text
  success       Boolean  @default(false)
  templateId    Int?
  sentAt        DateTime @default(now())

  @@index([sentAt])
}

// ── 반 ─────────────────────────────────────────────────
model Class {
  id        Int      @id @default(autoincrement())
  name      String // 반 이름 (예: 목요 3:00 A반)
  schedule  String? // 요일/시간 텍스트 (예: 월·목 15:00)
  capacity  Int      @default(8) // 정원
  color     String   @default("#6366f1")
  teacherId Int?
  teacher   User?    @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  students Student[]
}

// ── 학생 ───────────────────────────────────────────────
enum StudentStatus {
  ENROLLED // 재원
  PAUSED // 휴원
  WITHDRAWN // 퇴원
}

model Student {
  id           Int           @id @default(autoincrement())
  name         String
  grade        String // 학년 (예: 초3)
  phone        String // 연락처(핸드폰)
  phoneLast4   String // 뒷자리 4자리 (체크인 매칭용)
  status       StudentStatus @default(ENROLLED)
  registeredAt DateTime      @default(now())
  memo         String?       @db.Text
  classId      Int?
  class        Class?        @relation(fields: [classId], references: [id])

  attendances  Attendance[]
  observations Observation[]
  counsels     Counsel[]
  corrections  Correction[]
  clinics      Clinic[]
  makeups      MakeupClass[]
  examResults  ExamResult[]

  @@index([phoneLast4])
  @@index([status])
}

// ── 보강 수업 ──────────────────────────────────────────
// 정규수업 결석에 대한 보강 내역 기록. 학생별 여러 건 누적.
model MakeupClass {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  absentDate  DateTime @db.Date // 결석일
  makeupDate  DateTime @db.Date // 보강일
  weekday     Int // 보강요일 0=일 ... 6=토
  time        String? // 시간 (예: 16:00~17:00)
  attended    String? // 출석여부 (자유 입력)
  session     String? // 보강 차시
  progress    String?  @db.Text // 진도 외
  teacher     String? // 보강 담당T
  teacherNote String? // 보강 담당T 의견
  note        String? // 비고
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([makeupDate])
}

// ── 출결 ───────────────────────────────────────────────
enum AttendanceStatus {
  PRESENT // 출석
  LATE // 지각
  ABSENT // 결석
  MAKEUP // 보강
}

enum CheckInMethod {
  KEYPAD // 태블릿 뒷자리 체크인
  MANUAL // 수동 보정
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date // 수업일 (당일 1회 제약)
  checkInAt DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)
  method    CheckInMethod    @default(KEYPAD)
  note      String?

  @@unique([studentId, date])
  @@index([date])
}

// ── 관찰일지 (PDF 루브릭) ───────────────────────────────
// items: [{ area, item, level: '상'|'중'|'하', text, note }]
model Observation {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  round     Int // 회차
  date      DateTime @default(now())
  items     Json // 관찰 항목 배열
  memo      String?  @db.Text
  createdAt DateTime @default(now())

  counsels Counsel[]

  @@index([studentId])
}

// ── 상담 기록 ──────────────────────────────────────────
model Counsel {
  id            Int          @id @default(autoincrement())
  studentId     Int
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime     @default(now())
  type          String       @default("정기상담") // 상담 유형
  content       String       @db.Text
  nextAction    String?      @db.Text
  nextDate      DateTime?
  observationId Int?
  observation   Observation? @relation(fields: [observationId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([studentId])
}

// ── AI 서술형 첨삭 ─────────────────────────────────────
enum CorrectionStatus {
  UPLOADED // 업로드됨
  RECOGNIZED // 인식·확정
  DONE // 첨삭 완료
}

model Correction {
  id          Int              @id @default(autoincrement())
  studentId   Int?
  student     Student?         @relation(fields: [studentId], references: [id])
  title       String           @default("첨삭")
  images      Json? // 원본 답안 이미지 상대경로 배열(업로드 폴더 기준). 예: ["reading/corrections/12/01.jpg"]
  problemText String?          @db.Text // 인식된 문제
  answerText  String?          @db.Text // 인식된 답안
  genre       String? // 글의 종류
  gradeLevel  String? // 첨삭 기준 학년 (초1~초6)
  options     Json? // { tone, metrics[], custom, edenDirection }
  scores      Json? // 척도별 점수
  resultText  String?          @db.Text // AI 첨삭 결과(편집 가능)
  summary     String?          @db.Text // 이든 분석지 요약(총평)
  status      CorrectionStatus @default(UPLOADED)
  createdAt   DateTime         @default(now())

  @@index([studentId])
}

// ── 공지 템플릿 ────────────────────────────────────────
model NoticeTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @db.Text // {이름}{반}{점수}{특이점} 변수 포함
  variables Json // 변수 목록
  createdAt DateTime @default(now())
}

// ── 앱 설정 (key-value) ────────────────────────────────
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ── 클리닉 시간표 ──────────────────────────────────────
model Clinic {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekday   Int // 1=월 ... 6=토
  time      String // 시작 시간 "16:00"
  endTime   String? // 끝나는 시간 "17:00"
  subject   String   @default("클리닉")
  teacher   String? // 담당 선생님
  progress  String? // (레거시) 단일 진도 — 주차별 진도는 ClinicProgress 사용
  note      String?  @db.Text // 특이사항(비고)
  createdAt DateTime @default(now())

  progresses ClinicProgress[]

  @@index([weekday])
}

// ── 클리닉 주차별 진도 ──────────────────────────────────
// 월 구분 없는 1~4주차 순환. (clinicId, week) 유일. 클리닉 삭제 시 동반 삭제.
model ClinicProgress {
  id        Int      @id @default(autoincrement())
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  week      Int // 1~4
  content   String?  @db.Text
  updatedAt DateTime @updatedAt

  @@unique([clinicId, week])
  @@index([clinicId])
}

// ── 입학 테스트(문해력 진단 평가) ────────────────────────
// 시험지 1개 = 종류(이서/이룸/이든) + 회차. 문항 30개가 딸린다.
model Exam {
  id        Int      @id @default(autoincrement())
  type      String // ESEO(이서) | IROOM(이룸) | EDEN(이든) — lib/reading/exam.ts
  round     Int // 회차
  createdAt DateTime @default(now())

  items   ExamItem[]
  results ExamResult[]

  @@unique([type, round])
}

// 문항 정보(정답·배점·영역·독해능력·설명). 시험지 삭제 시 동반 삭제.
model ExamItem {
  id      Int     @id @default(autoincrement())
  examId  Int
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  no      Int // 문항 번호 1~30
  answer  Int // 정답 1~5
  score   Int // 배점
  area    String // 영역 (듣기말하기/어휘/문법/읽기/쓰기/문학/매체)
  ability String? // 독해능력 (사실적 독해/추론적 독해/수용과 생산/작품 이해)
  note    String? @db.Text // 문항 설명

  @@unique([examId, no])
}

// 학생 응시 결과. 학생 답은 문항 순서대로 JSON 배열로 보관한다(예: [3,1,null,...]).
model ExamResult {
  id         Int      @id @default(autoincrement())
  examId     Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  takenAt    DateTime @db.Date // 응시일
  answers    String   @db.Text // 학생 답 JSON 배열
  totalScore Int      @default(0) // 채점 결과(캐시)
  comment    String?  @db.Text // 종합의견
  createdAt  DateTime @default(now())

  @@unique([examId, studentId])
  @@index([studentId])
}
